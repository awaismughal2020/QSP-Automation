    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!DOCTYPE html>\n<html>\n<head>\n    <title>Phase 1 Complete</title>\n    <style>\n        body{font-family:system-ui,sans-serif;max-width:800px;margin:50px auto;padding:20px;background:#0f172a;color:#e2e8f0}\n        .box{background:#1e293b;padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.3)}\n        h1{color:#4ade80;margin-bottom:20px}\n        .phase-badge{display:inline-block;background:#3b82f6;color:#fff;padding:4px 12px;border-radius:4px;font-size:14px;margin-bottom:15px}\n        .btn{display:inline-block;margin:8px 8px 8px 0;padding:12px 20px;background:#3b82f6;color:#fff;text-decoration:none;border-radius:8px;font-weight:500}\n        .btn:hover{background:#2563eb}\n        .btn-next{background:#22c55e}\n        .btn-next:hover{background:#16a34a}\n        .stats{background:#0f172a;padding:15px;border-radius:8px;margin:15px 0}\n        .next-steps{background:#1e3a5f;padding:20px;border-radius:8px;margin:20px 0;border-left:4px solid #3b82f6}\n        .review-note{background:#1e3a5f;padding:15px;border-radius:8px;margin:15px 0;border-left:4px solid #f59e0b;color:#fcd34d}\n        a{color:#60a5fa}\n    </style>\n</head>\n<body>\n<div class=\"box\">\n    <span class=\"phase-badge\">Phase 1 of 3</span>\n    <h1>✅ Draft Files Generated!</h1>\n    <div class=\"stats\">\n        <p><strong>Job ID:</strong> {{ $json.job_id }}</p>\n        <p><strong>Execution Time:</strong> {{ $json.execution_time_seconds ? $json.execution_time_seconds.toFixed(1) + ' seconds' : 'N/A' }}</p>\n    </div>\n    <h3>📥 Download Generated Files for Review:</h3>\n    <p>\n    {{ ($json.output_files || []).map(f => '<a class=\"btn\" href=\"http://localhost:8000/api/v1/outputs/' + f.split('/').pop() + '\" target=\"_blank\">📄 ' + f.split('/').pop() + '</a>').join(' ') }}\n    </p>\n    <div class=\"review-note\">\n        <p><strong>⚠️ Important:</strong> These are draft files. Download and review both the <strong>Management Accounts</strong> and the <strong>Compliance Certificate</strong> before proceeding. Any edits you make will be used in all subsequent phases.</p>\n    </div>\n    <div class=\"next-steps\">\n        <h3>📋 Next Steps:</h3>\n        <ol>\n            <li>Download and review the <strong>Management Accounts</strong></li>\n            <li>Download and review the <strong>Compliance Certificate</strong></li>\n            <li>Make any necessary edits to both files</li>\n            <li>Proceed to <strong>Phase 2</strong> and re-upload the reviewed files</li>\n        </ol>\n        <a class=\"btn btn-next\" href=\"/form/generate-word-report\">➡️ Continue to Phase 2</a>\n    </div>\n    <p style=\"margin-top:25px\"><a href=\"/form/generate-accounts\">← Start Over</a></p>\n</div>\n</body>\n</html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html"
              }
            ]
          }
        }
      },
