    {
      "parameters": {
        "jsCode": "const year = $('Phase 1 Form').first().json.Year;\nconst quarterRaw = $('Phase 1 Form').first().json.Quarter;\nconst quarter = parseInt(quarterRaw.replace('Q', ''));\nconst bdo_file = $('Upload BDO').first().json.path;\nconst prev_ma_file = $('Upload MA').first().json.path;\nconst rent_roll_file = $('Upload Rent Roll').first().json.path;\nconst sales_tracker_file = $('Upload Sales').first().json.path;\nconst prev_compliance_file = $('Upload Compliance').first().json.path;\n\nreturn [{\n  json: {\n    year: year,\n    quarter: quarter,\n    bdo_file: bdo_file,\n    prev_ma_file: prev_ma_file,\n    rent_roll_file: rent_roll_file,\n    sales_tracker_file: sales_tracker_file,\n    prev_compliance_file: prev_compliance_file\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2656, 832],
      "id": "phase1-build-request",
      "name": "Build Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://qsp-automation-api:8000/api/v1/generate-accounts",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 600000
        }
      },
