    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!DOCTYPE html>\n<html>\n<head>\n    <title>Report Generated</title>\n    <style>\n        body{font-family:system-ui,sans-serif;max-width:800px;margin:50px auto;padding:20px;background:#0f172a;color:#e2e8f0}\n        .box{background:#1e293b;padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.3)}\n        h1{color:#4ade80;margin-bottom:20px}\n        .btn{display:inline-block;margin:8px 8px 8px 0;padding:12px 20px;background:#3b82f6;color:#fff;text-decoration:none;border-radius:8px;font-weight:500}\n        .btn:hover{background:#2563eb}\n        .warn{background:#422006;padding:15px;border-radius:8px;margin:15px 0;border-left:4px solid #f59e0b}\n        .stats{background:#0f172a;padding:15px;border-radius:8px;margin:15px 0}\n        a{color:#60a5fa}\n    </style>\n</head>\n<body>\n<div class=\"box\">\n    <h1>✅ Report Generated Successfully!</h1>\n    <div class=\"stats\">\n        <p><strong>Job ID:</strong> {{ $json.job_id }}</p>\n        <p><strong>Execution Time:</strong> {{ $json.execution_time_seconds ? $json.execution_time_seconds.toFixed(1) + ' seconds' : 'N/A' }}</p>\n    </div>\n    <h3>📥 Download Generated Files:</h3>\n    <p>\n    {{ ($json.output_files || []).map(f => '<a class=\"btn\" href=\"http://localhost:8000/api/v1/outputs/' + f.split('/').pop() + '\" target=\"_blank\">📄 ' + f.split('/').pop() + '</a>').join(' ') }}\n    </p>\n    {{ $json.warnings && $json.warnings.length > 0 ? '<div class=\"warn\"><strong>⚠️ Warnings:</strong><ul>' + $json.warnings.map(w => '<li>' + w + '</li>').join('') + '</ul></div>' : '' }}\n    <p style=\"margin-top:25px\"><a href=\"/form/qsp-report-form\">← Generate Another Report</a></p>\n</div>\n</body>\n</html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html"
              }
            ]
          }
        }
      },
      "id": "b2940763-9269-4cba-bc3a-bf4aa551ce42",
