    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!DOCTYPE html>\n<html>\n<head>\n    <title>Generation Failed</title>\n    <style>\n        body{font-family:system-ui,sans-serif;max-width:800px;margin:50px auto;padding:20px;background:#0f172a;color:#e2e8f0}\n        .box{background:#1e293b;padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.3)}\n        h1{color:#f87171}\n        .err{background:#450a0a;padding:20px;border-radius:8px;border-left:4px solid #ef4444}\n        .btn{display:inline-block;margin-top:20px;padding:12px 24px;background:#3b82f6;color:#fff;text-decoration:none;border-radius:8px}\n    </style>\n</head>\n<body>\n<div class=\"box\">\n    <h1>❌ Report Generation Failed</h1>\n    <div class=\"err\">\n        <p><strong>Error Details:</strong></p>\n        {{ ($json.errors || []).map(e => '<p>• ' + e + '</p>').join('') }}\n        {{ $json.detail ? '<p>• ' + $json.detail + '</p>' : '' }}\n        {{ $json.message ? '<p>• ' + $json.message + '</p>' : '' }}\n    </div>\n    <a class=\"btn\" href=\"/form/qsp-report-form\">🔄 Try Again</a>\n</div>\n</body>\n</html>",
        "options": {
          "responseCode": 500,
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html"
              }
            ]
          }
        }
      },
      "id": "387df3a7-fd66-4922-b389-555db0e0ceb2",
      "name": "Error Page",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
