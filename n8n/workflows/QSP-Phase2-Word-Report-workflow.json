    {
      "parameters": {
        "jsCode": "const year = $('Phase 2 Form').first().json.Year;\nconst quarterRaw = $('Phase 2 Form').first().json.Quarter;\nconst quarter = parseInt(quarterRaw.replace('Q', ''));\nconst management_accounts_file = $('Upload MA').first().json.path;\nconst compliance_certificate_file = $('Upload Compliance').first().json.path;\nconst rent_roll_file = $('Upload Rent Roll').first().json.path;\nconst sales_tracker_file = $('Upload Sales').first().json.path;\nconst word_template_file = $('Upload Word Template').first().json.path;\n\nreturn [{\n  json: {\n    year: year,\n    quarter: quarter,\n    management_accounts_file: management_accounts_file,\n    compliance_certificate_file: compliance_certificate_file,\n    rent_roll_file: rent_roll_file,\n    sales_tracker_file: sales_tracker_file,\n    word_template_file: word_template_file\n  }\n}];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2656, 832],
      "id": "phase2-build-request",
      "name": "Build Request"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://qsp-automation-api:8000/api/v1/generate-word-report",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          },
          "timeout": 600000
        }
      },
      "id": "phase2-generate",
      "name": "Generate Word Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [2912, 832]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 1
          },
          "conditions": [
            {
              "id": "success-check",
              "leftValue": "={{ $json.status }}",
              "rightValue": "success",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "phase2-success-check",
      "name": "Success?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [3152, 832]
    },
    {
      "parameters": {
        "respondWith": "text",
        "responseBody": "=<!DOCTYPE html>\n<html>\n<head>\n    <title>Phase 2 Complete</title>\n    <style>\n        body{font-family:system-ui,sans-serif;max-width:800px;margin:50px auto;padding:20px;background:#0f172a;color:#e2e8f0}\n        .box{background:#1e293b;padding:30px;border-radius:12px;box-shadow:0 4px 20px rgba(0,0,0,0.3)}\n        h1{color:#4ade80;margin-bottom:20px}\n        .phase-badge{display:inline-block;background:#8b5cf6;color:#fff;padding:4px 12px;border-radius:4px;font-size:14px;margin-bottom:15px}\n        .btn{display:inline-block;margin:8px 8px 8px 0;padding:12px 20px;background:#3b82f6;color:#fff;text-decoration:none;border-radius:8px;font-weight:500}\n        .btn:hover{background:#2563eb}\n        .btn-next{background:#22c55e}\n        .btn-next:hover{background:#16a34a}\n        .stats{background:#0f172a;padding:15px;border-radius:8px;margin:15px 0}\n        .next-steps{background:#1e3a5f;padding:20px;border-radius:8px;margin:20px 0;border-left:4px solid #8b5cf6}\n        a{color:#60a5fa}\n    </style>\n</head>\n<body>\n<div class=\"box\">\n    <span class=\"phase-badge\">Phase 2 of 3</span>\n    <h1>✅ Word Report Generated!</h1>\n    <div class=\"stats\">\n        <p><strong>Job ID:</strong> {{ $json.job_id }}</p>\n        <p><strong>Execution Time:</strong> {{ $json.execution_time_seconds ? $json.execution_time_seconds.toFixed(1) + ' seconds' : 'N/A' }}</p>\n    </div>\n    <h3>📥 Download Generated Files:</h3>\n    <p>\n    {{ ($json.output_files || []).map(f => '<a class=\"btn\" href=\"http://localhost:8000/api/v1/outputs/' + f.split('/').pop() + '\" target=\"_blank\">📝 ' + f.split('/').pop() + '</a>').join(' ') }}\n    </p>\n    <div class=\"next-steps\">\n        <h3>📋 Next Steps:</h3>\n        <ol>\n            <li>Download and review the <strong>Word Report</strong></li>\n            <li>Make any necessary edits to the Word Report</li>\n            <li>Proceed to <strong>Phase 3</strong> to generate the Final PDF</li>\n        </ol>\n        <a class=\"btn btn-next\" href=\"/form/generate-final-pdf\">➡️ Continue to Phase 3</a>\n    </div>\n    <p style=\"margin-top:25px\"><a href=\"/form/generate-accounts\">← Start Over (Phase 1)</a></p>\n</div>\n</body>\n</html>",
        "options": {
          "responseHeaders": {
            "entries": [
              {
                "name": "Content-Type",
                "value": "text/html"
              }
            ]
          }
        }
      },
      "id": "phase2-success-page",
