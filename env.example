# QSP Automation Environment Variables
# Copy this file to .env and update values as needed
# Command: cp env.example .env

# ============================================
# API Configuration
# ============================================
LOG_LEVEL=INFO

# ============================================
# n8n Configuration
# ============================================
N8N_USER=admin
N8N_PASSWORD=qsp2025

# ============================================
# AI Verification (Claude Opus 4.6)
# ============================================
# Required for AI-verified Management Accounts
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Number of Claude verification rounds. Default is 1 (single Opus call,
# pre-flight evaluator results injected into the prompt). Set to 3 to
# restore the legacy retry loop for hard quarters where the single
# round did not reconcile.
# AI_VERIFY_MAX_ROUNDS=1

# ============================================
# Optional: External Integrations
# ============================================
# OPENAI_API_KEY=your-api-key-here
# WEBHOOK_SECRET=your-webhook-secret

